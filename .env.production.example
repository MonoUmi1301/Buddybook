# BuddyBook — production env (docker-compose.prod.yml)
#   cp .env.production.example .env.production   (.env.production อยู่ใน .gitignore — ห้าม commit)
# ไฟล์เดียวใช้สองทาง: --env-file (แทนค่า ${...} ใน compose + build arg) และ env_file ของ api/migrate
# สุ่ม secret: openssl rand -hex 32

# ---------------------------------------------------------------- โดเมน
# ห้ามมี / ปิดท้าย — ใช้ประกอบ OAuth redirect_uri, ลิงก์ในอีเมล, Stripe return_url, KYC callback
APP_URL=https://buddybook.tech
# api มี origin เดียว (เว็บกับ api อยู่โดเมนเดียวกัน)
CORS_ORIGIN=https://buddybook.tech

# ---------------------------------------------------------------- Postgres (container "postgres")
# DATABASE_URL ประกอบใน docker-compose.prod.yml จากค่านี้ — ใช้ตัวอักษร/ตัวเลขล้วน (hex) จะได้ไม่ต้อง URL-encode
POSTGRES_PASSWORD=change-me-hex

# ---------------------------------------------------------------- Neo4j
# Neo4j Aura (ไม่มี container neo4j) — ค่าจากไฟล์ credentials ที่ดาวน์โหลดตอนสร้าง instance
# NEO4J_DATABASE ของ Aura คือ instance id (ตัวเดียวกับใน URI) หรือ neo4j ตามที่ไฟล์ credentials ระบุ
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=xxxxxxxx
NEO4J_READ_TIMEOUT_MS=2000

# ---------------------------------------------------------------- Auth (≥32 ตัวอักษร, สองตัวต้องต่างกัน)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# ใช้ร่วมกับ nlp-worker (≥32 ตัวอักษร)
INTERNAL_SERVICE_TOKEN=

# ---------------------------------------------------------------- Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
# จาก Dashboard > Developers > Webhooks > endpoint https://buddybook.tech/api/v1/webhooks/stripe
# (ไม่ใช่ค่าจาก `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...
# build arg ของ web — ฝังลง bundle ตอน build เปลี่ยนแล้วต้อง build web ใหม่
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------- Cloudinary (อัปโหลดรูปทั้งหมด)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- OAuth (ว่าง = ปิดปุ่มนั้น)
# redirect URI ที่ต้องลงทะเบียน: https://buddybook.tech/api/v1/auth/oauth/{google|line|facebook}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REQUEST_BIRTHDAY=false
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---------------------------------------------------------------- อีเมล (OTP สมัคร, ลืมรหัสผ่าน)
# ลอง Gmail SMTP ก่อนถ้าตั้งไว้ แล้วค่อย Resend — onboarding@resend.dev ส่งได้แค่อีเมลเจ้าของบัญชี ต้อง verify โดเมนก่อน
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
RESEND_FROM_EMAIL=BuddyBook <no-reply@buddybook.tech>

# ---------------------------------------------------------------- e-KYC (Didit) — none = ปิด
# เปิด didit แล้วต้องมี DIDIT_API_KEY, DIDIT_WORKFLOW_ID, DIDIT_WEBHOOK_SECRET, KYC_ID_HASH_SECRET (≥32)
# webhook: https://buddybook.tech/api/v1/webhooks/kyc/didit
KYC_PROVIDER=none
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# ห้ามเปลี่ยนหลังใช้งานจริง (hash เลขเอกสารเดิมจะเทียบไม่ได้)
KYC_ID_HASH_SECRET=

# ---------------------------------------------------------------- ค่าธุรกิจ / ปรับจูน (มีค่า default — ใส่เฉพาะที่จะเปลี่ยน)
GIFT_PLATFORM_FEE_PERCENT=10
GIFT_MAX_COINS_PER_SEND=100000
GIFT_SEND_RATE_LIMIT_PER_MIN=10
CHAPTER_PLATFORM_FEE_PERCENT=10
WITHDRAWAL_MIN_COINS=500
COIN_TO_THB_RATE=1
CHAPTER_READ_RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT_PER_15MIN=20
RECS_LONG_TAIL_LAMBDA=0.3
RECS_LONG_TAIL_TARGET=0.4
RECS_FRESH_DAYS=30
SCHEDULER_ENABLED=true
SCHEDULE_PUBLISH_INTERVAL_SEC=15
SCHEDULE_TRASH_PURGE_INTERVAL_SEC=3600
SCHEDULE_RECOMMENDATION_SYNC_INTERVAL_SEC=21600
SCHEDULE_GRAPH_HEAL_INTERVAL_SEC=60

# ---------------------------------------------------------------- NLP worker (--profile nlp)
# โฟลเดอร์โมเดล fine-tuned บน VPS (~400MB อยู่นอก repo) — mount เข้า /model แบบอ่านอย่างเดียว
NLP_MODEL_DIR=./apps/nlp-worker/model
