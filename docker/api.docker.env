# ค่าที่ "ทับ" apps/api/.env เฉพาะตอน api รันใน container (compose โหลด apps/api/.env ก่อนแล้วไฟล์นี้ทีหลัง)
# มีแค่ค่าที่ต่างจากตอนรัน Node บนเครื่อง — secret อื่น (Stripe/OAuth/JWT ฯลฯ) ยังมาจาก apps/api/.env เหมือนเดิม
# รหัสผ่านข้างล่างเป็นของ DB ใน Docker บนเครื่อง dev เท่านั้น (ตรงกับ docker-compose.yml) ไม่ใช่ secret จริง
#
# ใน container ต้องชี้ DB ด้วยชื่อ service (neo4j) ไม่ใช่ localhost
# DATABASE_URL ตั้งใน docker-compose.yml (เลือกได้ระหว่าง container postgres กับ PostgreSQL บน Windows ผ่าน .env ที่ root)

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=buddybook-dev
# Neo4j Community มีได้แค่ database "neo4j" (ค่าเดิมใน .env เป็นชื่อ instance ของ Aura)
NEO4J_DATABASE=neo4j

PORT=4000
NODE_ENV=development
