# โหมด "DB อย่างเดียว" — postgres + neo4j รันใน Docker แต่ api รันด้วย Node บนเครื่อง
# ใช้ผ่าน `node --env-file=...` (ดู script dev:api:dockerdb / docker:setup:host) ค่าที่นี่ถูกตั้งเป็น env
# ก่อน dotenv จะโหลด apps/api/.env จึงชนะค่าเดิม ส่วน secret อื่นยังมาจาก apps/api/.env ตามปกติ
#
# ชี้ localhost เพราะรันจากเครื่อง host — Postgres ใน Docker เปิดที่ 5525 (5432 เป็นของ PostgreSQL
# ที่ติดตั้งบน Windows อยู่แล้ว)

DATABASE_URL=postgresql://buddybook:buddybook@localhost:5525/buddybook?schema=public

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=buddybook-dev
NEO4J_DATABASE=neo4j
