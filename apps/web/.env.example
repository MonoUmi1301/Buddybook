# URL ของ Express API Gateway (ฝั่ง server-side rewrite ใน next.config.mjs)
API_URL=http://localhost:4000

# URL เดียวกัน แต่ต้องขึ้นต้นด้วย NEXT_PUBLIC_ เพื่อให้ฝั่ง client (browser) เรียกตรงได้
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# URL ที่เบราว์เซอร์ใช้เข้าเว็บ — ใช้สร้าง redirect ทุกตัว (OAuth callback, onboarding) ต้องตรงกับ APP_URL
# ของ apps/api (ที่ใช้ประกอบ redirect_uri ของ Google) ห้ามใช้ 0.0.0.0 ตอน deploy เปลี่ยนเป็นโดเมนจริง
APP_URL=http://localhost:3000

# Stripe publishable key (pk_...) — เปิดเผยฝั่ง client ได้ ดูได้ที่ dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
