# PostgreSQL 16 — ต้องมี extension pgcrypto ก่อน migrate ครั้งแรก:
#   CREATE EXTENSION IF NOT EXISTS pgcrypto;
# แก้ USER/PASSWORD/HOST/PORT/DBNAME ให้ตรงกับ connection ที่สร้างไว้ใน DBeaver
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/buddybook?schema=public"

# Neo4j 5.x (Recommendation Graph) — ดู recommendation_graph_import.cql ใน buddybook_real
# ใช้ Aura ให้ใช้ URI แบบ "neo4j+s://<instance-id>.databases.neo4j.io" (ดูค่าจริงในไฟล์ที่ดาวน์โหลดจาก
# console.neo4j.io ตอนสร้าง instance — ห้าม commit ไฟล์นั้นหรือ .env จริงเข้า git)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="changeme"
NEO4J_DATABASE="neo4j"

# Auth
JWT_SECRET="changeme-generate-a-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="changeme-generate-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Cloudinary (upload cover_image_url / avatar_url)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# SlipOK (สมัครได้ที่ slipok.com) — ใช้ตรวจสอบสลิปโอนเงินจริงตอนเติม coin (POST /wallet/topup/verify-slip)
SLIPOK_API_KEY=""
SLIPOK_BRANCH_ID=""
# เลขบัญชี/PromptPay ปลายทางจริงของระบบ — ปล่อยว่างได้ถ้ายังไม่มี (จะข้ามการเช็คบัญชีปลายทาง)
PAYMENT_RECEIVING_ACCOUNT=""

# Resend (ส่งอีเมล OTP ยืนยันตัวตนตอนสมัคร + ลืมรหัสผ่าน) — สมัครที่ resend.dev
# ต้อง verify โดเมนก่อนถึงจะส่งหาอีเมลอื่นนอกจากอีเมลเจ้าของบัญชี Resend ได้ (sandbox mode)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="BuddyBook <onboarding@resend.dev>"

# Gmail SMTP (ทางเลือกส่งอีเมลจริงที่ไม่ต้อง verify โดเมน) — เปิด 2-Step Verification ในบัญชี Google
# ก่อน แล้วสร้าง App Password ที่ myaccount.google.com/apppasswords (ห้ามใช้รหัสผ่าน Gmail จริง)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# OAuth — Google: console.cloud.google.com > APIs & Services > Credentials
# redirect URI ต้องลงทะเบียนไว้ตรงกับ APP_URL ด้านล่างเป๊ะ ๆ เช่น
# http://localhost:3000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# ใช้ประกอบ redirect_uri ตอนขอ token จาก OAuth provider — ตอน deploy จริงเปลี่ยนเป็นโดเมนจริง
APP_URL="http://localhost:3000"

# Internal service token (Python NLP Worker / Cron Scheduler → /internal/* endpoints)
INTERNAL_SERVICE_TOKEN="changeme-shared-secret-for-nlp-worker-and-cron"

# Stripe (เติม coin) — สมัคร/ดู key ได้ที่ dashboard.stripe.com/test/apikeys (เริ่มด้วย sk_test_
# ตอน dev แล้วค่อยเปลี่ยนเป็น sk_live_ ตอน deploy จริง) ห้าม commit key จริงเข้า git เด็ดขาด
STRIPE_SECRET_KEY=""
# ได้ค่านี้ตอนสร้าง webhook endpoint ใน Stripe Dashboard > Developers > Webhooks (ใช้ยืนยันว่า
# webhook ที่ยิงเข้ามาจริงมาจาก Stripe ไม่ใช่ปลอม)
STRIPE_WEBHOOK_SECRET=""
