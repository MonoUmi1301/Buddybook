{
  "name": "@buddybook/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:gift-assets": "tsx scripts/check-gift-assets.ts",
    "eval:recs": "tsx scripts/eval-recs.ts",
    "eval:recs:live": "tsx --env-file=.env scripts/eval-recommender.ts --save",
    "graph:resync": "tsx --env-file=.env scripts/resync-graph.ts",
    "graph:sync-accounts": "tsx --env-file=.env scripts/sync-account-types.ts",
    "db:mark-demo": "tsx scripts/mark-demo.ts",
    "db:line-emails": "tsx scripts/line-email-backfill.ts",
    "report:sentiment": "tsx scripts/report-sentiment.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ../../scripts/db-backup.mjs && prisma migrate dev",
    "prisma:studio": "prisma studio",
    "dev:dockerdb": "tsx watch --env-file=../../docker/host.docker.env src/server.ts",
    "db:setup": "node scripts/db-setup.mjs",
    "db:setup:dockerdb": "node --env-file=../../docker/host.docker.env scripts/db-setup.mjs",
    "db:seed:scale": "tsx prisma/seed-scale.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "neo4j-driver": "^5.20.0",
    "nodemailer": "^10.2.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "resend": "^6.25.0",
    "sanitize-html": "^2.18.1",
    "stripe": "^22.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.18.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
