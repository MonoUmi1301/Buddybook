# Express API Gateway base URL (apps/api)
API_BASE_URL="http://localhost:4000/api/v1"

# ต้องตรงกับ INTERNAL_SERVICE_TOKEN ใน apps/api/.env
INTERNAL_SERVICE_TOKEN="changeme-shared-secret-for-nlp-worker-and-cron"

# ความถี่ในการ poll หา comment/review ที่ยังไม่ได้วิเคราะห์ sentiment (วินาที)
POLL_INTERVAL_SECONDS=10

# ดึงมาวิเคราะห์ทีละกี่แถวต่อรอบ
BATCH_SIZE=20

# path ไปยังโฟลเดอร์โมเดล fine-tuned (v4 — ดีที่สุดทั้ง Wisesight test และ eval/test_set.csv ดู docs/evaluation.md)
# วางโมเดลไว้ที่ apps/nlp-worker/model/ (อยู่ใน .gitignore + .dockerignore — model.safetensors ~400MB ห้าม commit)
# docker-compose mount โฟลเดอร์เดียวกันนี้เข้า /model ให้อัตโนมัติ
MODEL_PATH="./model"

# temperature scaling — ทำให้ความมั่นใจ/ขั้วของโมเดลไม่ติดเพดาน ±1 (label ไม่เปลี่ยน)
# หาค่าใหม่ทุกครั้งที่เปลี่ยนโมเดล: python eval/calibrate.py (v4 = 1.0 คือไม่ต้องปรับ · v2 = 1.5)
SENTIMENT_TEMPERATURE=1.0

# กฎ target.py — พลิก "ด่าตัวละครเพราะอิน" จาก neg เป็น pos ใช้กับ v2 (77.8% → 89.4%)
# v4 เรียนเคสนี้เองแล้ว เปิดกฎกลับทำให้แย่ลง (93.9% → 92.2%) จึงปิด (1 = เปิด, 0 = ปิด)
SENTIMENT_TARGET_RULE=0
