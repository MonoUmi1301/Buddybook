# Express API Gateway base URL (apps/api)
API_BASE_URL="http://localhost:4000/api/v1"

# ต้องตรงกับ INTERNAL_SERVICE_TOKEN ใน apps/api/.env
INTERNAL_SERVICE_TOKEN="changeme-shared-secret-for-nlp-worker-and-cron"

# ความถี่ในการ poll หา comment/review ที่ยังไม่ได้วิเคราะห์ sentiment (วินาที)
POLL_INTERVAL_SECONDS=10

# ดึงมาวิเคราะห์ทีละกี่แถวต่อรอบ
BATCH_SIZE=20

# path ไปยังโฟลเดอร์โมเดล fine-tuned (my_final_sentiment_model จาก buddybook_real/My_Novel_Project
# — โฟลเดอร์นี้อยู่นอก repo ตั้งใจ เพราะไฟล์ model.safetensors หนัก ~400MB ไม่ควร commit เข้า git)
MODEL_PATH="../../../buddybook_real/My_Novel_Project/my_final_sentiment_model"
