{
  "name": "buddybook",
  "private": true,
  "version": "0.1.0",
  "description": "BuddyBook — Thai web novel platform monorepo (Next.js 14 + Express + Prisma/PostgreSQL + Neo4j + Python NLP Worker)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "test": "npm test --workspace=apps/api",
    "test:e2e": "playwright test -c e2e",
    "typecheck": "npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web && npm run lint --workspace=apps/api",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "seed:scale": "npm run db:seed:scale --workspace=apps/api --",
    "docker:up": "docker compose --profile app up -d --build",
    "docker:down": "docker compose --profile app down",
    "docker:setup": "docker compose --profile app exec api node scripts/db-setup.mjs",
    "docker:logs": "docker compose --profile app logs -f --tail=100",
    "docker:ps": "docker compose --profile app ps",
    "docker:rebuild": "docker compose --profile app up -d --build --renew-anon-volumes api web",
    "docker:reset": "docker compose --profile app down -v",
    "docker:db": "docker compose up -d --wait",
    "docker:setup:dockerdb": "npm run db:setup:dockerdb --workspace=apps/api",
    "dev:api:dockerdb": "npm run dev:dockerdb --workspace=apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "typescript": "^5.5.4"
  }
}
